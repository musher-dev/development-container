// Musher Dev Container — Batteries-included template.
// Uncomment optional blocks as needed. Comment out what you don't use.
//
// No image of our own: the Microsoft base image, the Features below, and the
// lifecycle scripts in scripts/. Decision: docs/decisions/0004.
{
  "name": "Musher Dev",
  // The LTS tag, not floating `:ubuntu`, which rolls to interim releases that
  // docker-in-docker does not support. Dependabot raises Features, not this
  // tag: bump it by hand.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Which tier a tool belongs in: docs/configuration.md → "Runtimes & Tools".
  "features": {
    // --- Platform ---
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "2.96.0" },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    // Every CLI that is not a Feature is a mise pin in .config/mise/config.toml.
    // Local, not devcontainers-extra's mise Feature: that one calls
    // api.github.com on every build. Keep `version` equal to the config's
    // min_version (TOOL-04); verify-toolchain.sh fails on drift.
    "./features/mise": { "version": "2026.8.6" },

    // --- Runtimes ---
    "ghcr.io/devcontainers/features/node:2": { "version": "24.18.0" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.13.14" },
    "ghcr.io/devcontainers/features/go:1": { "version": "1.26.5" },
    "ghcr.io/devcontainers/features/java:1": {
      // jdkDistro is pinned because the Feature's default ("ms", Microsoft
      // OpenJDK) disappeared from SDKMAN's index: `sdk list java` returns no
      // -ms builds at all, and the install fails with "Version 17 not found.
      // Available versions:" followed by nothing. Temurin is the Eclipse
      // Adoptium build and carries 17.
      "version": "17",
      "jdkDistro": "tem",
      "installGradle": false,
      "installMaven": false
    },
    "ghcr.io/devcontainers-extra/features/deno:1": { "version": "2.9.2" },
    // Rust (uncomment for a Cargo product, as host-agent). Pair it with the
    // target/ volume under "mounts", and pin the toolchain in the product's
    // rust-toolchain.toml.
    // "ghcr.io/devcontainers/features/rust:1": { "version": "1.98.1", "profile": "minimal" },

    // --- Linting ---
    "ghcr.io/lukewiwa/features/shellcheck:0": { "version": "v0.11.0" },

    // --- Database tooling ---
    "ghcr.io/robbert229/devcontainer-features/postgresql-client:1": { "version": "16" }

    // Optional infrastructure (OpenTofu, tflint, doctl, cloudflared) and
    // protobuf (buf) tools are commented mise pins in .config/mise/config.toml.
  },

  "containerUser": "vscode",
  "remoteUser": "vscode",

  "init": true,
  "shutdownAction": "stopContainer",

  // Allow debuggers (gdb, strace, delve) to attach to processes.
  "capAdd": ["SYS_PTRACE"],

  // One volume per purpose per container (DEVC-08): logins, agent sessions,
  // shell history and download caches survive a rebuild. Each target's parent
  // already exists in the image, so Docker creates no root-owned directory on
  // the way; post-create takes ownership of the volumes themselves.
  "mounts": [
    "source=musher-${devcontainerId}-gh-config,target=/home/vscode/.config/gh,type=volume",
    "source=musher-${devcontainerId}-claude-config,target=/home/vscode/.claude,type=volume",
    "source=musher-${devcontainerId}-codex-config,target=/home/vscode/.codex,type=volume",
    "source=musher-${devcontainerId}-shell-history,target=/home/vscode/.shell-history,type=volume",
    "source=musher-${devcontainerId}-cache,target=/home/vscode/.cache,type=volume"
    // Docker-in-Docker needs no line here: its Feature keeps /var/lib/docker
    // and /var/lib/containerd on volumes of its own, which outlive a rebuild.
    // Product dependencies and build output (node_modules/, Rust's target/),
    // kept off the bind mount. Must sit under the declared product --
    // docs/layout.md → "Ecosystem Adapters":
    // "source=musher-${devcontainerId}-node-modules,target=/workspaces/${localWorkspaceFolderBasename}/<product>/node_modules,type=volume"
    // "source=musher-${devcontainerId}-target,target=/workspaces/${localWorkspaceFolderBasename}/<product>/target,type=volume"
  ],

  // Codespaces prompts for these at creation time. The block must list exactly
  // the bindings declaring `source: host` in env.schema.yaml (ENVS-15). Built
  // locally, pass the same keys through remoteEnv as "${localEnv:KEY}";
  // `repo env sync` copies them into .env either way.
  // "secrets": {
  //   "EXAMPLE_API_KEY": { "description": "...", "documentationUrl": "https://..." }
  // },

  // The codespace machine. `cpus` alone picks the size; a `memory` equal to a
  // Docker Desktop VM's size reads as unmet locally (binary units) and warns
  // on every open.
  // "hostRequirements": { "cpus": 4 },

  "containerEnv": {
    // Auto-trust .config/mise/config.toml so `mise install` runs without a
    // prompt. mise finds the file itself.
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}",

    // Claude keeps .claude.json beside its config dir, so without this it
    // lands in ~/ -- outside the claude volume -- and is lost on every rebuild.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",

    // Every Claude Code session starts at max effort. An env var because the
    // settings file's effortLevel has no "max"; it also outranks /effort, so
    // start a lighter session as `CLAUDE_CODE_EFFORT_LEVEL=auto claude`.
    "CLAUDE_CODE_EFFORT_LEVEL": "max",

    // REPL histories join the shell's on its volume; post-create points zsh
    // and bash there.
    "NODE_REPL_HISTORY": "/home/vscode/.shell-history/node_repl_history",
    "PYTHON_HISTORY": "/home/vscode/.shell-history/python_history",
    "PSQL_HISTORY": "/home/vscode/.shell-history/psql_history",

    // corepack resolves pnpm/yarn from package.json `packageManager` without
    // asking first; post-create runs `corepack enable`.
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",

    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "UV_LINK_MODE": "copy",
    "XDG_CACHE_HOME": "/home/vscode/.cache",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "RUFF_CACHE_DIR": "/home/vscode/.cache/ruff",
    "PIP_CACHE_DIR": "/home/vscode/.cache/pip",
    "MYPY_CACHE_DIR": "/home/vscode/.cache/mypy",
    "NPM_CONFIG_CACHE": "/home/vscode/.cache/npm",
    "DENO_DIR": "/home/vscode/.cache/deno",
    "GOMODCACHE": "/home/vscode/.cache/go/mod",
    "GOCACHE": "/home/vscode/.cache/go/build",
    "BUN_INSTALL_CACHE_DIR": "/home/vscode/.cache/bun"
  },

  "remoteEnv": {
    // ~/.local/bin (Claude Code). The mise Feature puts mise itself and its
    // shims (task, uv, codex, lefthook, ...) on PATH.
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}",

    // The host's GH_TOKEN, when it exports one: the first credential
    // lib/github-auth.sh offers gh. Not GH_TOKEN itself, which would override
    // gh's stored login on every call.
    "MUSHER_HOST_GH_TOKEN": "${localEnv:GH_TOKEN}"
  },

  // No initializeCommand: nothing runs on the host. post-create writes
  // .devcontainer/.env from env.schema.yaml inside the container.
  // Line endings are enforced repo-wide by .gitattributes (`* text=auto eol=lf`).
  // post-attach finishes the GitHub credential once VS Code has copied the
  // host's ~/.gitconfig, which happens only after post-create.
  "waitFor": "postCreateCommand",
  "postCreateCommand": ["bash", ".devcontainer/scripts/post-create.sh"],
  "postStartCommand": ["bash", ".devcontainer/scripts/startup.sh"],
  "postAttachCommand": ["bash", ".devcontainer/scripts/post-attach.sh"],

  "forwardPorts": [15432, 15433, 15434, 15435, 15436, 15440, 15441, 15442, 15443, 15444, 15445, 15446, 15447, 15448, 15460],
  "portsAttributes": {
    "15432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "15433": { "label": "Redis", "onAutoForward": "silent" },
    "15434": { "label": "MinIO API", "onAutoForward": "silent" },
    "15435": { "label": "MinIO Console", "onAutoForward": "silent" },
    "15436": { "label": "OCI Registry", "onAutoForward": "silent" },
    "15440": { "label": "MinIO API (Observability)", "onAutoForward": "silent" },
    "15441": { "label": "MinIO Console (Observability)", "onAutoForward": "silent" },
    "15442": { "label": "Tempo", "onAutoForward": "silent" },
    "15443": { "label": "Loki", "onAutoForward": "silent" },
    "15444": { "label": "VictoriaMetrics", "onAutoForward": "silent" },
    "15445": { "label": "OTel HTTP", "onAutoForward": "silent" },
    "15446": { "label": "OTel gRPC", "onAutoForward": "silent" },
    "15447": { "label": "Grafana", "onAutoForward": "silent" },
    "15448": { "label": "Pyroscope", "onAutoForward": "silent" },
    "15460": { "label": "Azimutt", "onAutoForward": "silent" }
  },

  "customizations": {
    // A codespace's token reads only this repository. Name each other private
    // repository the dev tasks read (release assets, GHCR images, GitHub
    // Packages publishers); Codespaces asks once, at creation.
    // "codespaces": {
    //   "repositories": {
    //     "musher-dev/<repo>": { "permissions": { "contents": "read", "packages": "read" } }
    //   }
    // },
    "vscode": {
      "extensions": [
        // --- AI ---
        // Claude Code's editor integration; the CLI comes from post-create.
        "anthropic.claude-code",

        // --- Core tooling ---
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",

        // --- Language support ---
        "golang.go",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",

        // --- Shell linting ---
        "timonwong.shellcheck",

        // --- Optional (comment out if not needed) ---
        "eamodio.gitlens",
        "github.copilot",
        "github.copilot-chat",
        "bierner.markdown-mermaid"

        // --- Optional: SQL client (uncomment if using PostgreSQL) ---
        // "mtxr.sqltools",
        // "mtxr.sqltools-driver-pg",

        // --- Optional: Additional extensions (uncomment as needed) ---
        // "tomoki1207.pdf",
        // "jebbs.plantuml",
        // "contextmapper.context-mapper-vscode-extension",
        // "ChaunceyKiwi.json-tree-view",
        // "github.vscode-pull-request-github",
        // "hashicorp.terraform",
        // "wholroyd.jinja",
        // "batisteo.vscode-django"
      ],
      "settings": {
        // --- Editor ---
        "editor.formatOnSave": true,
        "editor.rulers": [80, 120],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,

        // --- Terminal ---
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash" },
          "zsh": { "path": "/bin/zsh" }
        },

        // --- Go ---
        "go.toolsManagement.autoUpdate": true,

        // --- Python ---
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },

        // --- Prettier formatter overrides ---
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  }
}
