// Musher dev container image — the definition release.yaml publishes as
// ghcr.io/musher-dev/development-container:<version>.
//
// Everything here except `build` rides in the image's devcontainer.metadata
// label, so a repo that names the image inherits it: the platform Features,
// the vscode user, the config volumes, the cache env and the lifecycle
// scripts baked at /usr/local/share/musher-devcontainer/. A consuming repo's
// devcontainer.json adds only its runtimes, stacks and ports.
//
// Decision: docs/decisions/0001-the-scaffold-is-published-as-a-pinned-image.md
{
  "name": "Musher Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "2.96.0" },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/lukewiwa/features/shellcheck:0": { "version": "v0.11.0" },
    "ghcr.io/robbert229/devcontainer-features/postgresql-client:1": { "version": "16" }
  },

  "containerUser": "vscode",
  "remoteUser": "vscode",
  "init": true,
  "capAdd": ["SYS_PTRACE"],

  // One volume per tool per container (DEVC-08): logins survive a rebuild.
  "mounts": [
    "source=musher-${devcontainerId}-gh-config,target=/home/vscode/.config/gh,type=volume",
    "source=musher-${devcontainerId}-claude-config,target=/home/vscode/.claude,type=volume",
    "source=musher-${devcontainerId}-codex-config,target=/home/vscode/.codex,type=volume"
  ],

  "containerEnv": {
    // Auto-trust the workspace's .config/mise/config.toml.
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}",
    // Keeps .claude.json on the claude volume rather than in ~/.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",

    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "UV_LINK_MODE": "copy",
    "XDG_CACHE_HOME": "/home/vscode/.cache",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "RUFF_CACHE_DIR": "/home/vscode/.cache/ruff",
    "PIP_CACHE_DIR": "/home/vscode/.cache/pip",
    "MYPY_CACHE_DIR": "/home/vscode/.cache/mypy",
    "NPM_CONFIG_CACHE": "/home/vscode/.cache/npm",
    "DENO_DIR": "/home/vscode/.cache/deno",
    "GOMODCACHE": "/home/vscode/.cache/go/mod",
    "GOCACHE": "/home/vscode/.cache/go/build",
    "BUN_INSTALL_CACHE_DIR": "/home/vscode/.cache/bun"
  },

  "remoteEnv": {
    // mise shims + ~/.local/bin (Claude Code).
    "PATH": "/home/vscode/.local/share/mise/shims:/home/vscode/.local/bin:${containerEnv:PATH}"
  },

  "waitFor": "postCreateCommand",
  "postCreateCommand": ["bash", "/usr/local/share/musher-devcontainer/post-create.sh"],
  "postStartCommand": ["bash", "/usr/local/share/musher-devcontainer/startup.sh"],

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker",
        "timonwong.shellcheck"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash" },
          "zsh": { "path": "/bin/zsh" }
        }
      }
    }
  }
}
